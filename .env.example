# Скопіюйте цей файл у ".env" і заповніть.

# 1) Дані для входу у ваш акаунт: https://my.telegram.org → API development tools
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# 2) Токен бота від @BotFather (/newbot)
BOT_TOKEN=1234567890:AAAbbbCCCdddEEE...

# 3) Три групи через кому: @юзернейм, посилання t.me/... або числовий ID (див. list_chats.py)
GROUPS=@group_one, https://t.me/group_two, -1001234567890

# Куди слати сповіщення. Порожньо = вам в особисті від бота.
# Можна вказати ID групи/чату, куди додано бота (дізнатися — командою /id у боті).
NOTIFY_CHAT_ID=

# Як часто перевіряти, секунд (мінімум 15)
CHECK_INTERVAL=60

# Скільки останніх повідомлень у кожній групі перевірити при ПЕРШОМУ запуску (0 = лише нові)
INITIAL_LOOKBACK=0

# Не надсилати те саме оголошення (та сама назва станції й ціна) повторно протягом N хвилин,
# у будь-якому з каналів. 0 = вимкнено
DEDUP_MINUTES=30

# Часовий пояс у сповіщеннях
TIMEZONE=Europe/Kyiv
